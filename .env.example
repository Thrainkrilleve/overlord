# ========================================================
# DISCORD OVERLORD CONFIGURATION
# ========================================================
# One process can moderate every server it is invited to.
# Channel, role, and account-age values below are copied once into the
# GUILD_ID server on first start. Every other server is configured in Discord
# with /config set. After that first start, editing the IDs in this file does
# not change a server that already has saved settings.

# Required: Bot Application Token from https://discord.com/developers/applications
DISCORD_TOKEN="YOUR_BOT_TOKEN_HERE"

# Server that receives the channel and role IDs below on first start.
# Leave this set for an existing deployment so that server keeps working.
# Other servers do not need to be listed here.
GUILD_ID=123456789012345678

# Optional. Set to true only for local development, to register slash commands
# in GUILD_ID and nowhere else. Leave unset (or false) when the bot is in
# more than one server.
# DEV_GUILD_ONLY=false

# Database connection string (SQLite file path). Only used when running with `cargo run`;
# docker-compose.yml always stores the database in ./data so it survives rebuilds.
DATABASE_URL="sqlite://overlord.db?mode=rwc"

# --------------------------------------------------------
# INITIAL SETTINGS FOR THE GUILD_ID SERVER
# --------------------------------------------------------
# Right-click a channel, category, or role in Discord (Developer Mode on) and
# copy its ID. Delete a line to leave that feature off for the first server.
# Further servers set the same things with /config set.

# Honeypot trap channel (Hidden from verified members; any message triggers an instant ban)
HONEYPOT_CHANNEL_ID=123456789012345678

# Human verification channel (where /setup_verification was posted; shown in /security_status)
VERIFY_CHANNEL_ID=123456789012345678

# Staff moderation & security audit log channel
MOD_LOG_CHANNEL_ID=123456789012345678

# Closed ticket transcript archive channel (required to close tickets)
TRANSCRIPT_CHANNEL_ID=123456789012345678

# Join-to-Create master voice channel (e.g. "➕ Join to Create")
JOIN_TO_CREATE_CHANNEL_ID=123456789012345678

# Category ID under which temporary voice channels will spawn
VOICE_CATEGORY_ID=123456789012345678

# Category ID under which support ticket channels will spawn
TICKET_CATEGORY_ID=123456789012345678

# --------------------------------------------------------
# ROLES
# --------------------------------------------------------

# Role assigned to new members before completing verification
UNVERIFIED_ROLE_ID=123456789012345678

# Role granted after successful human verification
MEMBER_ROLE_ID=123456789012345678

# Staff/Moderator role with access to tickets and mod logs
MOD_ROLE_ID=123456789012345678

# --------------------------------------------------------
# SECURITY POLICIES
# --------------------------------------------------------

# Minimum account age in days (new accounts younger than this get flagged in mod logs)
MIN_ACCOUNT_AGE_DAYS=3

# --------------------------------------------------------
# WEB DASHBOARD (off until DASHBOARD_ENABLED=true)
# --------------------------------------------------------
# Same process and database. Leave disabled and the bot behaves as before.
# Placeholders only. Do not commit a real client secret or hostname.

DASHBOARD_ENABLED=false
DASHBOARD_BIND=0.0.0.0:8080
# Host port on 127.0.0.1 that the tunnel connects to. Change this if 8080 is already taken.
# The process inside the container still listens on 8080.
DASHBOARD_HOST_PORT=8080
DASHBOARD_PUBLIC_URL=https://overlord.example.com
DASHBOARD_DISCORD_CLIENT_ID=123456789012345678
DASHBOARD_DISCORD_CLIENT_SECRET=your-oauth-client-secret
DASHBOARD_OAUTH_REDIRECT_URL=https://overlord.example.com/auth/callback
# Secure cookies. Set false only when trying the dashboard over plain http.
DASHBOARD_COOKIE_SECURE=true
# Use CF-Connecting-IP for rate limits only when Cloudflare Tunnel is the only client.
DASHBOARD_TRUST_CLOUDFLARE=false
# Permission bitfield on the bot invite opened by GET /install. This matches the invite in SETUP.
# 1099798014998 already includes Manage Channels and Manage Roles, used when the dashboard creates channels and roles.
DASHBOARD_INVITE_PERMISSIONS=1099798014998
