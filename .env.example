# ========================================================
# DISCORD OVERLORD CONFIGURATION
# ========================================================

# Required: Bot Application Token from https://discord.com/developers/applications
DISCORD_TOKEN="YOUR_BOT_TOKEN_HERE"

# Optional: Server/Guild ID for instant slash command registration (recommended during setup)
# If omitted, commands will register globally (can take up to 1 hour to propagate)
GUILD_ID=123456789012345678

# Database connection string (SQLite file path). Only used when running with `cargo run`;
# docker-compose.yml always stores the database in ./data so it survives rebuilds.
DATABASE_URL="sqlite://overlord.db?mode=rwc"

# --------------------------------------------------------
# CHANNELS
# --------------------------------------------------------

# Honeypot trap channel (Hidden from verified members; any message triggers an instant ban)
HONEYPOT_CHANNEL_ID=123456789012345678

# Human verification channel (where /setup_verification was posted; shown in /security_status)
VERIFY_CHANNEL_ID=123456789012345678

# Staff moderation & security audit log channel
MOD_LOG_CHANNEL_ID=123456789012345678

# Closed ticket transcript archive channel (required to close tickets)
TRANSCRIPT_CHANNEL_ID=123456789012345678

# Join-to-Create master voice channel (e.g. "➕ Join to Create")
JOIN_TO_CREATE_CHANNEL_ID=123456789012345678

# Category ID under which temporary voice channels will spawn
VOICE_CATEGORY_ID=123456789012345678

# Category ID under which support ticket channels will spawn
TICKET_CATEGORY_ID=123456789012345678

# --------------------------------------------------------
# ROLES
# --------------------------------------------------------

# Role assigned to new members before completing verification
UNVERIFIED_ROLE_ID=123456789012345678

# Role granted after successful human verification
MEMBER_ROLE_ID=123456789012345678

# Staff/Moderator role with access to tickets and mod logs
MOD_ROLE_ID=123456789012345678

# --------------------------------------------------------
# SECURITY POLICIES
# --------------------------------------------------------

# Minimum account age in days (new accounts younger than this get flagged in mod logs)
MIN_ACCOUNT_AGE_DAYS=3
